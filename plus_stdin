import sys

def tonum(s):
    try:
        return int(s)    #intは文字列を整数に（失敗すると例外発生）
    except ValueError:    #第3回で見たエラーの名前
        return float(s)
x=0
for line sys.stdin:
     x += tonum(line.rstrip()) 
print(x)

